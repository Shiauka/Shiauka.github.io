---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { episodes } from '@/data/episodes'
import { getCollection } from 'astro:content'
import { openTs, isPublished } from '@/lib/publish'

const SPOTIFY_SHOW_URL = 'https://open.spotify.com/show/033d989NU4Dv5YcXBwnr8g'

// 公開日當天「晚上 7 點（台灣 UTC+8）」才開放連結（openTs 已處理時區）。
function mmdd(pubDate: string): string {
  const [, m, d] = pubDate.split('-').map(Number)
  return `${m}/${d}`
}

const now = Date.now()

const withMeta = episodes.map(ep => ({
  ...ep,
  openTs: ep.pubDate ? openTs(ep.pubDate) : Number.POSITIVE_INFINITY,
}))

// 已公開 = 有 youtubeId 且公開日（19:00 TW）已到。
const isLive = (ep: typeof withMeta[number]) => !!ep.youtubeId && ep.openTs <= now

const live     = withMeta.filter(isLive).sort((a, b) => b.ep - a.ep)
const upcoming  = withMeta.filter(ep => !isLive(ep)).sort((a, b) => a.ep - b.ep)
const nextEp    = upcoming[0]
const sorted    = [...(nextEp ? [nextEp] : []), ...live, ...upcoming.slice(1)]

const articlesAll = await getCollection('articles', ({ data }) => !data.draft && data.episode != null)
const articlesByEp: Record<number, typeof articlesAll> = {}
for (const article of articlesAll) {
  const ep = article.data.episode!
  if (!articlesByEp[ep]) articlesByEp[ep] = []
  articlesByEp[ep].push(article)
}
for (const ep of Object.values(articlesByEp)) {
  ep.sort((a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime())
}
---

<BaseLayout
  title="播客"
  description="一個工程師的財務自白——全集數列表。從資產配置理念到實際操作，每集聚焦一個主題。"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">

    <!-- 標題 -->
    <div class="mb-10">
      <p class="text-brand font-medium text-sm uppercase tracking-wide mb-2">Podcast</p>
      <h1 class="text-3xl font-bold mb-3">一個工程師的財務自白</h1>
      <p class="text-gray-600 max-w-2xl">
        把複雜的投資邏輯拆解成一集一集的故事。每集聚焦一個主題，
        從理念到工具，從策略到紀律，帶你建立自己的投資系統。
      </p>
      <div class="flex flex-wrap gap-3 mt-5">
        <a
          href={SPOTIFY_SHOW_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#1DB954] hover:bg-[#1aa34a] text-white text-sm font-semibold px-4 py-2 rounded-full transition-colors"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
          在 Spotify 收聽
        </a>
        <a
          href="https://www.youtube.com/@luge.finance"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold px-4 py-2 rounded-full transition-colors"
        >
          ▶ 在 YouTube 收看
        </a>
      </div>
    </div>

    <!-- 集數列表 -->
    <div class="space-y-3">
      {sorted.map(ep => {
        const live     = isLive(ep)
        const hasYt    = !!ep.youtubeId
        const scheduled = hasYt && !live          // 已上傳排程、但公開日還沒到
        const isNext   = nextEp && ep.ep === nextEp.ep
        const epArts   = articlesByEp[ep.ep] ?? []
        const ytUrl    = `https://www.youtube.com/watch?v=${ep.youtubeId}`
        return (
          <div
            data-publish-ts={scheduled ? String(ep.openTs) : undefined}
            class={`p-5 rounded-xl border transition-all ${
              live
                ? 'border-gray-200 hover:border-brand hover:shadow-md'
                : isNext
                  ? 'border-brand/40 bg-brand/5'
                  : 'border-dashed border-gray-200 opacity-50'
            }`}
          >
            <div class="flex items-start gap-4">
              <!-- EP 編號 -->
              <div class="shrink-0 w-12 h-12 rounded-lg bg-brand/10 flex items-center justify-center">
                <span class="text-brand font-bold text-sm">{String(ep.ep).padStart(2, '0')}</span>
              </div>

              <!-- 內容 -->
              <div class="flex-1 min-w-0">
                <!-- 標題 + 狀態 -->
                <div class="flex items-start justify-between gap-3 mb-1">
                  <h2 class="font-semibold leading-snug">{ep.title}</h2>

                  {live && (
                    <a
                      href={ytUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="shrink-0 text-xs font-medium text-red-600 border border-red-200 rounded px-2 py-0.5 hover:bg-red-50 transition-colors whitespace-nowrap"
                    >
                      ▶ 觀看
                    </a>
                  )}

                  {scheduled && (
                    <>
                      <a
                        href={ytUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-reveal-ts={String(ep.openTs)}
                        class="watch-link hidden shrink-0 text-xs font-medium text-red-600 border border-red-200 rounded px-2 py-0.5 hover:bg-red-50 transition-colors whitespace-nowrap"
                      >
                        ▶ 觀看
                      </a>
                      <span
                        data-until-ts={String(ep.openTs)}
                        class="soon-badge shrink-0 text-xs text-gray-400 whitespace-nowrap"
                      >
                        🔒 {mmdd(ep.pubDate)} 晚間上線
                      </span>
                    </>
                  )}

                  {!hasYt && isNext && (
                    <span class="shrink-0 text-xs text-brand font-medium whitespace-nowrap">下一集</span>
                  )}
                  {!hasYt && !isNext && (
                    <span class="shrink-0 text-xs text-gray-400 whitespace-nowrap">即將上架</span>
                  )}
                </div>

                <!-- 簡介 -->
                <p class="text-sm text-gray-500">{ep.desc}</p>

                <!-- 對應文章 -->
                {epArts.length > 0 && (
                  <div class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1">
                    {epArts.map(article => {
                      const artLive = isPublished(article.data.pubDate, now)
                      return (
                        <a
                          href={`/articles/${article.slug}`}
                          data-reveal-ts={artLive ? undefined : String(openTs(article.data.pubDate))}
                          class:list={['text-xs text-brand hover:underline', { hidden: !artLive }]}
                        >
                          📖 {article.data.title}
                        </a>
                      )
                    })}
                  </div>
                )}
              </div>
            </div>
          </div>
        )
      })}
    </div>

  </div>
</BaseLayout>

<script>
  import '@/scripts/reveal.ts'
</script>
