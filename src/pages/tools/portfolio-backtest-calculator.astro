  </div>

  <script is:inline>
    // ===== 純函式 BEGIN（不碰 DOM；獨立驗證可整段抽出來跑）=====
    var KEYS = ['VT', 'VOO', '0050', 'QQQ', '00631L', 'VEA', 'VWO', 'IAU', 'BTC'];
    var SHORT = { VT: 'VT', VOO: '標普 500（VOO）', '0050': '0050', QQQ: 'QQQ', '00631L': '00631L（正 2）', VEA: 'VEA', VWO: 'VWO', IAU: '黃金（IAU）', BTC: '比特幣（BTC-USD）' };
    var BUCKETS = [
      { name: '核心', keys: ['VOO', '0050'] },
      { name: '攻擊', keys: ['QQQ', '00631L'] },
      { name: '全球分散', keys: ['VEA', 'VWO'] },
      { name: '另類', keys: ['IAU', 'BTC'] },
    ];
    var EVENTS = [
      { key: '2020', label: '2020 疫情崩跌', a: '2020-02-14', b: '2020-04-30' },
      { key: '2022', label: '2022 升息下跌', a: '2021-11-08', b: '2022-10-31' },
      { key: '2025', label: '2025 春季下跌', a: '2025-02-18', b: '2025-04-30' },
    ];
    var START_YEARS = [2016, 2024];       // 可選起算年範圍
    var REBALS = ['yearly', 'none', 'band'];  // 每年第一個交易日／不再平衡／偏離門檻才調回
    var BAND_PP = 5;                      // 偏離門檻（百分點）：任一桶（含現金）占總資產比例偏離目標 ≥ 5 個百分點，當天收盤整個組合調回
    var BUCKET_OF = { VOO: 0, '0050': 0, QQQ: 1, '00631L': 1, VEA: 2, VWO: 2, IAU: 3, BTC: 3 };   // 核心、攻擊、全球分散、另類；VT 不屬於任何桶，不單獨檢查
    var RATE_LIM = [0, 20];               // 現金年息範圍（%）
    var SUM_TOL = 0.005;                  // 合計與 100 的容許差（%，四捨五入誤差）
    // 預設比例（範例）：取整數的大略配置，占總資產 80%，另外 20% 是現金（合計剛好 100）；不是任何人的實際持有比例。
    // 完整四桶＝八檔；兩桶版＝只留核心（VOO、0050）與全球分散（VEA、VWO），把 80% 放滿。
    var PRESETS = {
      full:  { name: '完整四桶', cash: 20, w: { VOO: 20, '0050': 17, QQQ: 15, '00631L': 6, VEA: 7, VWO: 7, IAU: 5, BTC: 3 } },
      vt:    { name: '80% 全 VT', cash: 20, w: { VT: 80 } },
      plain: { name: '兩桶版（核心＋全球分散）', cash: 20, w: { VOO: 31, '0050': 27, VEA: 11, VWO: 11 } },
      small: { name: 'VT＋小衛星', cash: 20, w: { VT: 60, '0050': 12, IAU: 8 } },
    };
    var DEFAULTS = { preset: 'full', rate: 1.5, rebal: 'yearly', startYear: 2016 };

    function isBlank(s) { return String(s === undefined || s === null ? '' : s).trim() === ''; }
    // 百分比欄位：吃全形數字、%、前後空白、U+2212 負號；不吃逗號（19,3 會被當成看不懂）；其他一律 NaN
    function parsePct(s) {
      var str = String(s === undefined || s === null ? '' : s).normalize('NFKC').replace(/[\s%]/g, '').replace(/^[−–—]/, '-');
      if (str === '' || !/^[-+]?(\d+(\.\d*)?|\.\d+)$/.test(str)) return NaN;
      var v = parseFloat(str);
      return isFinite(v) ? v : NaN;
    }
    function trimNum(v, d) { var s = (Math.round(v * Math.pow(10, d)) / Math.pow(10, d)).toString(); return s; }

    // raw：{ w:{VT:'..',...}, cash:'', rate:'', rebal:'yearly'|'none'|'band', startYear:'2016' }（全是字串）
    // 回傳 { ok, errors, sum, sumOff, weights, cash, rate(小數), rebal(字串 yearly|none|band), startYear, scale }
    // 不會悄悄改任何值：有錯誤或合計不是 100 就 ok=false（不計算）；合計與 100 差在 SUM_TOL 內視為四捨五入誤差，計算時等比例換算成 100。
    function normalizeInputs(raw) {
      var errors = [], badIds = [], weights = {}, sum = 0;
      function bad(id, msg) { errors.push(msg); badIds.push(id); return NaN; }
      function one(id, label, r, lo, hi, blankOk, eg) {
        if (isBlank(r)) {
          if (blankOk) return 0;
          return bad(id, label + '：空白，請填數字');
        }
        var v = parsePct(r);
        if (!isFinite(v)) return bad(id, label + '：看不懂「' + String(r).trim() + '」，請填數字（例：' + (eg || '19.3') + '）');
        if (v < lo) return bad(id, label + '：不能小於 ' + lo + '（你填 ' + String(r).trim() + '）');
        if (v > hi) return bad(id, label + '：不能大於 ' + hi + '（你填 ' + String(r).trim() + '）');
        return v;
      }
      KEYS.forEach(function (k) {
        var v = one('w-' + k, SHORT[k], raw.w[k], 0, 100, true);
        weights[k] = isFinite(v) ? v : 0; if (isFinite(v)) sum += v;
      });
      var cash = one('w-cash', '現金', raw.cash, 0, 100, true);
      if (isFinite(cash)) sum += cash; else cash = 0;
      var ratePct = one('rate', '現金年息', raw.rate, RATE_LIM[0], RATE_LIM[1], false, '1.5');
      var rebal = raw.rebal;
      if (REBALS.indexOf(rebal) < 0) { bad('rebal', '再平衡：請選每年第一個交易日、不再平衡或偏離 5 個百分點才調回'); rebal = 'yearly'; }
      var sy = String(raw.startYear === undefined || raw.startYear === null ? '' : raw.startYear).trim();
      var startYear = /^\d{4}$/.test(sy) ? parseInt(sy, 10) : NaN;
      if (!(startYear >= START_YEARS[0] && startYear <= START_YEARS[1])) { bad('startYear', '起算年：請選 ' + START_YEARS[0] + ' 到 ' + START_YEARS[1]); startYear = NaN; }
      var sumOff = errors.length === 0 && Math.abs(sum - 100) > SUM_TOL + 1e-9;
      var ok = errors.length === 0 && !sumOff;
      var scale = 1;
      var w2 = weights, c2 = cash;
      if (ok && Math.abs(sum - 100) > 1e-9) {
        scale = 100 / sum; w2 = {}; KEYS.forEach(function (k) { w2[k] = weights[k] * scale; }); c2 = cash * scale;
      }
      return { ok: ok, errors: errors, badIds: badIds, sum: sum, sumOff: sumOff, weights: w2, cash: c2, rawWeights: weights, rawCash: cash,
        rate: isFinite(ratePct) ? ratePct / 100 : NaN, ratePct: ratePct, rebal: rebal, startYear: startYear, scale: scale };
    }

    function validateData(data) {
      if (!data || !Array.isArray(data.dates) || data.dates.length < 300 || !data.px) return '資料格式不對';
      var n = data.dates.length;
      for (var i = 0; i < n; i++) {
        if (!/^\d{4}-\d{2}-\d{2}$/.test(data.dates[i])) return '日期格式不對';
        if (i > 0 && !(data.dates[i] > data.dates[i - 1])) return '日期沒有由舊到新排列';
      }
      for (var j = 0; j < KEYS.length; j++) {
        var a = data.px[KEYS[j]];
        if (!Array.isArray(a) || a.length !== n) return KEYS[j] + ' 價格筆數不對';
        for (var m = 0; m < n; m++) if (!(a[m] > 0) || !isFinite(a[m])) return KEYS[j] + ' 價格有缺值';
      }
      return '';
    }
    function buildCtx(data) {
      var n = data.dates.length, day = new Float64Array(n), year = new Int16Array(n), ym = new Int32Array(n);
      for (var i = 0; i < n; i++) {
        var p = data.dates[i].split('-');
        day[i] = Date.UTC(+p[0], +p[1] - 1, +p[2]) / 86400000; year[i] = +p[0]; ym[i] = +p[0] * 12 + (+p[1] - 1);
      }
      return { dates: data.dates, day: day, year: year, ym: ym, px: data.px, n: n };
    }
    function startIndex(ctx, startYear) { for (var i = 0; i < ctx.n; i++) if (ctx.year[i] >= startYear) return i; return -1; }

    // 與 ep67_backtest.simulate 同算法：起點總值 100；現金按日曆天數 (1+r)^(天/365) 複利。
    // rebal='yearly'：每年第一個交易日把各標的與現金調回目標；'none'：只在起點配置一次；
    // 'band'：每個交易日收盤檢查四個桶（核心＝VOO＋0050、攻擊＝QQQ＋00631L、全球分散＝VEA＋VWO、另類＝IAU＋BTC）與現金，
    //   任一個占總資產的比例偏離目標 ≥ BAND_PP 個百分點，當天收盤整個組合調回目標（VT 不屬於桶，不單獨檢查；全 VT 時 VT 與現金互為補數，看現金就等於看 VT）。
    // weights／cashPct 以占總資產 % 表示（合計 100）；回傳 { i0, v, nReb }，v[k] 對應 ctx.dates[i0+k]，nReb＝起點之後調回目標的次數
    function simulate(ctx, weights, cashPct, rate, rebal, startYear) {
      var i0 = startIndex(ctx, startYear), n = ctx.n - i0;
      var v = new Float64Array(n);
      var keys = KEYS.filter(function (k) { return weights[k] > 0; });
      var arrs = keys.map(function (k) { return ctx.px[k]; });
      var units = keys.map(function () { return 0; });
      var tgt = [0, 0, 0, 0];
      KEYS.forEach(function (k) { if (BUCKET_OF[k] !== undefined) tgt[BUCKET_OF[k]] += weights[k]; });
      var cash = cashPct, total = 100, started = false, prevYear = null, prevDay = null, nReb = 0;
      for (var k = 0; k < n; k++) {
        var i = i0 + k, j, value, doReb = false;
        if (prevDay !== null) cash *= Math.pow(1 + rate, (ctx.day[i] - prevDay) / 365);
        if (!started) { value = total; doReb = true; }
        else {
          value = cash; for (j = 0; j < keys.length; j++) value += units[j] * arrs[j][i];
          if (rebal === 'yearly') doReb = ctx.year[i] !== prevYear;
          else if (rebal === 'band') {
            var bv = [0, 0, 0, 0];
            for (j = 0; j < keys.length; j++) if (BUCKET_OF[keys[j]] !== undefined) bv[BUCKET_OF[keys[j]]] += units[j] * arrs[j][i];
            if (Math.abs(cash / value * 100 - cashPct) >= BAND_PP) doReb = true;
            for (j = 0; j < 4 && !doReb; j++) if (Math.abs(bv[j] / value * 100 - tgt[j]) >= BAND_PP) doReb = true;
          }
        }
        if (doReb) {
          if (started) nReb++;
          total = started ? value : 100;
          cash = total * cashPct / 100;
          for (j = 0; j < keys.length; j++) units[j] = total * weights[keys[j]] / 100 / arrs[j][i];
          value = total; started = true;
        }
        prevYear = ctx.year[i]; prevDay = ctx.day[i]; v[k] = value;
      }
      return { i0: i0, v: v, nReb: nReb };
    }

    // 與 ep67_backtest.metrics 同算法，但「年化波動」改用月報酬：每個日曆月最後一個交易日的組合價值，
    // 相鄰月底之間的月報酬（第一個月底之前的不算），取母體標準差 × √12。日報酬版本另存為 volDaily（頁面不顯示）。
    // v 為與 ctx.dates[i0..] 對齊的價值序列
    function metrics(ctx, i0, v) {
      var n = v.length, d0 = ctx.day[i0], d1 = ctx.day[i0 + n - 1];
      var yrs = (d1 - d0) / 365.25;
      var cagr = Math.pow(v[n - 1] / v[0], 1 / yrs) - 1;
      var m = n - 1, mean = 0, k;
      var rets = new Float64Array(m);
      for (k = 1; k < n; k++) { rets[k - 1] = v[k] / v[k - 1] - 1; mean += rets[k - 1]; }
      mean /= m;
      var ss = 0; for (k = 0; k < m; k++) ss += (rets[k] - mean) * (rets[k] - mean);
      var volDaily = Math.sqrt(ss / m) * Math.sqrt(252);
      var me = [];                                    // 每個日曆月最後一個交易日（相對 v 的位置）
      for (k = 0; k < n; k++) if (k === n - 1 || ctx.ym[i0 + k + 1] !== ctx.ym[i0 + k]) me.push(k);
      var mm = me.length - 1, vol = NaN;
      if (mm >= 2) {
        var mr = new Float64Array(mm), mmean = 0;
        for (k = 1; k < me.length; k++) { mr[k - 1] = v[me[k]] / v[me[k - 1]] - 1; mmean += mr[k - 1]; }
        mmean /= mm;
        var ss2 = 0; for (k = 0; k < mm; k++) ss2 += (mr[k] - mmean) * (mr[k] - mmean);
        vol = Math.sqrt(ss2 / mm) * Math.sqrt(12);
      }
      var peak = v[0], pk = 0, mdd = 0, mddPk = 0, mddLo = 0;
      for (k = 0; k < n; k++) {
        if (v[k] > peak) { peak = v[k]; pk = k; }
        var dd = v[k] / peak - 1;
        if (dd < mdd) { mdd = dd; mddPk = pk; mddLo = k; }
      }
      var pkV = v[mddPk], rec = -1;
      for (k = mddLo + 1; k < n; k++) if (v[k] >= pkV) { rec = k; break; }
      return { final: v[n - 1], cagr: cagr, vol: vol, volDaily: volDaily, nMonthRets: mm, mdd: mdd, years: yrs,
        pkDate: ctx.dates[i0 + mddPk], loDate: ctx.dates[i0 + mddLo],
        recDate: rec >= 0 ? ctx.dates[i0 + rec] : null,
        recDays: rec >= 0 ? ctx.day[i0 + rec] - ctx.day[i0 + mddPk] : null,
        sincePeakDays: ctx.day[i0 + n - 1] - ctx.day[i0 + mddPk], noDrop: mdd === 0 };
    }

    // 與 ep67_backtest.window_dd 同算法：窗口 [a,b] 內，窗口第一個交易日到窗口最低的跌幅與最低日
    // inside＝窗口起點不早於這次回測的第一天（早於就只是半個窗口，頁面不顯示）
    function windowDD(ctx, i0, v, a, b) {
      var n = v.length, k0 = -1, k1 = -1, k;
      for (k = 0; k < n; k++) {
        var d = ctx.dates[i0 + k];
        if (d > b) break;
        if (d >= a && k0 < 0) k0 = k;
        k1 = k;
      }
      if (k0 < 0 || k1 < k0) return null;
      var lo = k0; for (k = k0; k <= k1; k++) if (v[k] < v[lo]) lo = k;
      return { dd: v[lo] / v[k0] - 1, lowDate: ctx.dates[i0 + lo], startDate: ctx.dates[i0 + k0], inside: a >= ctx.dates[i0] };
    }

    // 與 ep67_backtest.calendar_returns 同算法：每年報酬 ＝ 年底值 ÷ 前一年底值；第一年從起算日當天算起
    function calendarReturns(ctx, i0, v) {
      var n = v.length, out = [], prev = v[0], cur = ctx.year[i0], last = v[0];
      for (var k = 0; k < n; k++) {
        var y = ctx.year[i0 + k];
        if (y !== cur) { out.push({ year: cur, ret: last / prev - 1 }); prev = last; cur = y; }
        last = v[k];
      }
      out.push({ year: cur, ret: last / prev - 1, lastDate: ctx.dates[i0 + n - 1] });
      return out;
    }

    function runPortfolio(ctx, weights, cashPct, p) {
