      window.addEventListener('resize', function () { clearTimeout(rz); rz = setTimeout(function () { if (lastCompute && loadState === 'ok') drawChart(lastCompute); }, 120); });

      resetAll();
      loadData();
    })();
  </script>
</BaseLayout>
