      <a href="/articles/ep68-real-hourly-wage" class="inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-lg bg-brand text-white hover:bg-brand-dark transition-colors">讀 EP68 完整文章 →</a>
      <a href="/articles/ep47-income-redundancy" class="inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:border-brand transition-colors">副業該追求什麼（EP47）</a>
      <a href="/tools" class="inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:border-brand transition-colors">看其他工具</a>
    </div>

  </div>

  <script is:inline>
    // ===== 純函式 BEGIN（不碰 DOM；獨立驗證可整段抽出來跑）=====
    var JOB_FIELDS = ['pay', 'work', 'oncall', 'idle', 'idleRatio', 'commute', 'days', 'commuteCost', 'otherCost', 'tax'];
    var LIM = {
      pay: { lo: 0, hi: 1e9, name: '年收入', money: true },
      work: { lo: 0, hi: 168, name: '每週工時' },
      oncall: { lo: 0, hi: 168, name: '待命處理時間' },
      idle: { lo: 0, hi: 168, name: '沒被叫的待命時間' },
      idleRatio: { lo: 0, hi: 100, name: '待命折算成數' },
      commute: { lo: 0, hi: 600, name: '通勤單程分鐘' },
      days: { lo: 0, hi: 7, name: '每週進公司天數' },
      commuteCost: { lo: 0, hi: 1e7, name: '每月車錢', money: true },
      otherCost: { lo: 0, hi: 1e7, name: '每月其他花費', money: true },
      tax: { lo: 0, hi: 1e9, name: '年稅額', money: true },
      weeks: { lo: 1, hi: 52, name: '一年上班週數' },
    };
    var DEFAULTS = {
      A: { name: '工作 A', pay: 1500000, work: 60, oncall: 3, idle: 0, idleRatio: 0, commute: 60, days: 5, commuteCost: 0, otherCost: 0, tax: 81620 },
      B: { name: '工作 B', pay: 1100000, work: 45, oncall: 0, idle: 0, idleRatio: 0, commute: 20, days: 5, commuteCost: 0, otherCost: 0, tax: 33620 },
      weeks: 47, taxMode: 'single', rate: 12,
    };
    var STD_WEEK = 40;
    // 115 年度綜所稅（單身、只有薪資、標準扣除）
    var TAX115 = { exempt: 101000, stdDed: 136000, salaryDed: 227000,
      brackets: [[610000, 0.05, 0], [1380000, 0.12, 42700], [2770000, 0.20, 153100], [5190000, 0.30, 430100], [Infinity, 0.40, 949100]] };

    function parseMoney(s) {
      var str = String(s === undefined || s === null ? '' : s).normalize('NFKC').replace(/NT\$|\$|,|，|、|\s|元/gi, '');
      var sign = 1;
      if (/^[-−]/.test(str)) { sign = -1; str = str.slice(1); }
      if (str === '') return NaN;
      var mm = str.match(/^(?:(\d+(?:\.\d+)?)億)?(?:(\d+(?:\.\d+)?)萬)?(\d+(?:\.\d+)?)?$/);
      if (!mm || (mm[1] === undefined && mm[2] === undefined && mm[3] === undefined)) return NaN;
      var v = (mm[1] ? parseFloat(mm[1]) * 1e8 : 0) + (mm[2] ? parseFloat(mm[2]) * 1e4 : 0) + (mm[3] ? parseFloat(mm[3]) : 0);
      return isFinite(v) ? sign * v : NaN;
    }
    function parseNum(s) {
      var str = String(s === undefined || s === null ? '' : s).normalize('NFKC').replace(/[%％,，\s]/g, '').replace(/^−/, '-');
      if (str === '' || !/^[-+]?(\d+(\.\d*)?|\.\d+)$/.test(str)) return NaN;
      var v = parseFloat(str);
      return isFinite(v) ? v : NaN;
    }
    function roundTo(v, d) { var f = Math.pow(10, d); return Math.round(v * f + (v >= 0 ? 1e-9 : -1e-9)) / f; }

    // 115 年度單身、只有薪資、標準扣除的綜所稅
    function incomeTax115(pay) {
      var salaryDed = Math.min(Math.max(pay, 0), TAX115.salaryDed);
      var net = Math.max(0, pay - salaryDed - TAX115.exempt - TAX115.stdDed);
      for (var i = 0; i < TAX115.brackets.length; i++) {
        var b = TAX115.brackets[i];
        if (net <= b[0]) return { tax: Math.max(0, net * b[1] - b[2]), net: net, rate: b[1] };
      }
    }

    // raw: { A: {欄位: 字串}, B: {...}, weeks, taxMode, rate }；回傳 { p, msgs, changed }
    function normalizeInputs(raw) {
      var msgs = [], changed = { A: {}, B: {} }, p = { A: {}, B: {} };
      ['A', 'B'].forEach(function (j) {
        var r = raw[j] || {};
        var nm = String(r.name === undefined || r.name === null ? '' : r.name).trim();
        p[j].name = nm === '' ? DEFAULTS[j].name : nm.slice(0, 20);
        JOB_FIELDS.forEach(function (k) {
          var L = LIM[k], def = DEFAULTS[j][k];
          var s = r[k];
          var v = L.money ? parseMoney(s) : parseNum(s);
          var label = p[j].name + L.name;
          if (!isFinite(v)) {
            msgs.push(label + (String(s === undefined || s === null ? '' : s).trim() === '' ? '空白，已改用預設 ' : '看不懂，已改用 ') + def);
            v = def; changed[j][k] = true;
          }
          if (v < L.lo) { msgs.push(label + '不能小於 ' + L.lo + '，已改成 ' + L.lo); v = L.lo; changed[j][k] = true; }
          if (v > L.hi) { msgs.push(label + '不能大於 ' + L.hi + '，已改成 ' + L.hi); v = L.hi; changed[j][k] = true; }
          var rr = L.money ? Math.round(v) : roundTo(v, 2);
          if (rr !== v) changed[j][k] = true;
          p[j][k] = rr;
        });
      });
      var w = parseNum(raw.weeks), L = LIM.weeks;
      if (!isFinite(w)) { msgs.push('一年上班週數' + (String(raw.weeks === undefined || raw.weeks === null ? '' : raw.weeks).trim() === '' ? '空白，已改用預設 ' : '看不懂，已改用 ') + DEFAULTS.weeks); w = DEFAULTS.weeks; changed.weeks = true; }
      if (w < L.lo) { msgs.push('一年上班週數不能小於 1，已改成 1'); w = L.lo; changed.weeks = true; }
      if (w > L.hi) { msgs.push('一年上班週數不能大於 52，已改成 52'); w = L.hi; changed.weeks = true; }
      var wr = roundTo(w, 1); if (wr !== w) changed.weeks = true;
      p.weeks = wr;
      p.taxMode = ['single', 'custom', 'rate'].indexOf(raw.taxMode) >= 0 ? raw.taxMode : DEFAULTS.taxMode;
      var rt = parseNum(raw.rate);
      p.rate = [0, 5, 12, 20, 30, 40].indexOf(rt) >= 0 ? rt : DEFAULTS.rate;
      return { p: p, msgs: msgs, changed: changed };
    }

    // 單一份工作：每週時數拆項、一年時數、現金成本、稅
    function jobStats(j, weeks, taxMode) {
      var commuteWeek = j.commute * 2 * j.days / 60;
      var idleCounted = j.idle * j.idleRatio / 100;
      var weekTotal = j.work + j.oncall + idleCounted + commuteWeek;
      var yearHours = weekTotal * weeks;
      var cost = (j.commuteCost + j.otherCost) * 12;
      var tax = null, taxInfo = null;
      if (taxMode === 'single') { taxInfo = incomeTax115(j.pay); tax = taxInfo.tax; }
      else if (taxMode === 'custom') { tax = j.tax; }
      var netCash = j.pay - cost;
      function per(money, h) { return h > 0 ? money / h : null; }
      return {
        commuteWeek: commuteWeek, idleCounted: idleCounted, weekTotal: weekTotal, yearHours: yearHours,
        cost: cost, tax: tax, taxInfo: taxInfo, netCash: netCash, netAfterTax: tax === null ? null : netCash - tax,
        paper: per(j.pay, STD_WEEK * weeks),
        l1: per(j.pay, j.work * weeks),
        l2: per(j.pay, (j.work + j.oncall + idleCounted) * weeks),
        l3: per(j.pay, yearHours),
        real: per(netCash, yearHours),
        realAfterTax: tax === null ? null : per(netCash - tax, yearHours),
      };
    }

    function compute(p) {
      var A = jobStats(p.A, p.weeks, p.taxMode), B = jobStats(p.B, p.weeks, p.taxMode);
      var res = { A: A, B: B, weeks: p.weeks, taxMode: p.taxMode, rate: p.rate };
      if (A.yearHours <= 0 || B.yearHours <= 0) { res.invalid = true; return res; }
      // 收入高的那份（以扣掉現金成本後的稅前收入比）
      if (A.netCash === B.netCash) { res.same = true; return res; }
      var hiKey = A.netCash > B.netCash ? 'A' : 'B', loKey = hiKey === 'A' ? 'B' : 'A';
      var hi = res[hiKey], lo = res[loKey];
      res.hiKey = hiKey; res.loKey = loKey;
      res.dMoney = hi.netCash - lo.netCash;
      res.dHoursYear = hi.yearHours - lo.yearHours;
      res.dHoursWeek = hi.weekTotal - lo.weekTotal;
      if (p.taxMode === 'rate') res.dTax = (p[hiKey].pay - p[loKey].pay) * p.rate / 100;   // 現金成本不能抵稅
      else res.dTax = hi.tax - lo.tax;
      res.dMoneyAfterTax = res.dMoney - res.dTax;
      if (res.dHoursYear > 1e-9) {
        res.marginal = res.dMoney / res.dHoursYear;
        res.marginalAfterTax = res.dMoneyAfterTax / res.dHoursYear;
      } else { res.noExtraTime = true; }
      // 門檻：多賺的錢 ÷ 上班週數 ÷ 時數少那份的真實時薪（稅前）
      var base = lo.real;
      if (base !== null && base > 0) {
        res.threshold = res.dMoney / p.weeks / base;
        // 收入高的那份，年收入要多少，真實時薪才追得上（稅前；現金成本照扣）
        res.breakeven = base * hi.yearHours + hi.cost;
      }
      function winOf(a, b) {
        if (a === null || b === null) return null;
        if (Math.round(a) === Math.round(b)) return 'tie';   // 四捨五入到元後同分＝幾乎打平
        return a > b ? 'A' : 'B';
      }
      res.winner = winOf(A.real, B.real);
      res.winnerAfterTax = winOf(A.realAfterTax, B.realAfterTax);
      // 收入高那份已經贏：breakeven 是「降到多少以下才會輸」；輸了：「要到多少才追平」
      if (res.breakeven !== undefined) res.breakevenType = (A.real !== null && B.real !== null && res[hiKey].real > res[loKey].real) ? 'floor' : 'match';
      return res;
    }
    // ===== 純函式 END =====

    window.__ep68 = { parseMoney: parseMoney, parseNum: parseNum, incomeTax115: incomeTax115, normalizeInputs: normalizeInputs, jobStats: jobStats, compute: compute, DEFAULTS: DEFAULTS, LIM: LIM };

    (function () {
      function $(id) { return document.getElementById(id); }
      function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
      function ntd(v) { return Math.round(v).toLocaleString('en-US'); }
      function hr(v) { return v === null || v === undefined ? '—' : ntd(v) + ' 元'; }
      function h1(v) { return roundTo(v, 1).toLocaleString('en-US', { maximumFractionDigits: 1 }); }
      function card(label, value, desc, accent) {
        return '<div class="rounded-2xl border border-gray-200 p-5 bg-white"><div class="text-sm text-gray-500 mb-1">' + label + '</div>' +
          '<div class="text-2xl font-bold ' + (accent ? '' : 'text-gray-900') + '"' + (accent ? ' style="color:#C5611A"' : '') + '>' + value + '</div>' +
          '<div class="text-xs text-gray-500 mt-1 leading-relaxed">' + desc + '</div></div>';
      }
      var lastMsgs = [];
      function readRaw() {
        var r = { A: {}, B: {} };
        ['A', 'B'].forEach(function (j) { r[j].name = $(j + '_name').value; JOB_FIELDS.forEach(function (k) { r[j][k] = $(j + '_' + k).value; }); });
        r.weeks = $('weeks').value; r.taxMode = $('taxMode').value; r.rate = $('rate').value;
        return r;
      }
      function fmtField(k, v) { return LIM[k] && LIM[k].money ? ntd(v) : String(v); }
      function writeFields(p, onlyChanged, changed) {
        ['A', 'B'].forEach(function (j) {
          JOB_FIELDS.forEach(function (k) {
            var el = $(j + '_' + k);
            if (!onlyChanged || (changed[j][k] && document.activeElement !== el)) el.value = fmtField(k, p[j][k]);
          });
        });
        if (!onlyChanged || (changed.weeks && document.activeElement !== $('weeks'))) $('weeks').value = String(p.weeks);
      }
      function syncTaxUI() {
        var m = $('taxMode').value;
        document.querySelectorAll('.taxCustom').forEach(function (el) { el.classList.toggle('hidden', m !== 'custom'); });
        $('rateWrap').classList.toggle('hidden', m !== 'rate');
      }

      function render(commit, keepNotice) {
        syncTaxUI();
        var n = normalizeInputs(readRaw());
        var p = n.p, msgs = n.msgs;
        ['A', 'B'].forEach(function (j) {
          var j0 = p[j];
          var wk = j0.work + j0.oncall + j0.idle * j0.idleRatio / 100 + j0.commute * 2 * j0.days / 60;
          if (wk > 168) msgs.push(j0.name + '一週加起來 ' + h1(wk) + ' 小時，超過一週的 168 小時，請檢查');
        });
        if (msgs.length) lastMsgs = msgs.slice(); else if (!commit || keepNotice === false) lastMsgs = [];
        var shown = msgs.length ? msgs : lastMsgs;
        if (commit) writeFields(p, false); else writeFields(p, true, n.changed);
        var notice = $('notice');
        notice.textContent = shown.join('；');
        notice.classList.toggle('hidden', shown.length === 0);

        var c = compute(p);
        var nA = esc(p.A.name), nB = esc(p.B.name);
        ['thA', 'thA2'].forEach(function (id) { $(id).textContent = p.A.name; });
        ['thB', 'thB2'].forEach(function (id) { $(id).textContent = p.B.name; });
        var A = c.A, B = c.B;
        var after = c.taxMode !== 'rate';

        // Cards
        var cardsHtml = card(nA + '的真實時薪', hr(A.real), '稅前' + (after ? '；稅後 ' + hr(A.realAfterTax) : '') + '｜一週 ' + h1(A.weekTotal) + ' 小時') +
          card(nB + '的真實時薪', hr(B.real), '稅前' + (after ? '；稅後 ' + hr(B.realAfterTax) : '') + '｜一週 ' + h1(B.weekTotal) + ' 小時');
        if (c.invalid) cardsHtml += card('多出來的時間每小時值多少', '—', '有一份工作的總時數是 0，算不出來', true);
        else if (c.same) cardsHtml += card('多出來的時間每小時值多少', '—', '兩份扣掉現金成本後的收入一樣，直接比時數就好', true);
        else if (c.noExtraTime) cardsHtml += card('多出來的時間每小時值多少', '不用多花時間', esc(p[c.hiKey].name) + '收入比較高，花的時間也沒有比較多', true);
        else cardsHtml += card('多出來的時間每小時值多少', hr(c.marginal), '稅前；稅後 ' + hr(c.marginalAfterTax) + '｜一年多 ' + ntd(c.dHoursYear) + ' 小時', true);
        $('cards').innerHTML = cardsHtml;

        // Conclusion
        var html = '';
        if (A.yearHours <= 0 || B.yearHours <= 0) {
          html = '<p>有一份工作的總時數是 0，算不出時薪。請填入每週工時。</p>';
        } else if (c.same) {
          html = '<p class="font-semibold text-gray-900 mb-2">兩份扣掉現金成本後的收入一樣</p><p>那就看誰花的時間少：' + (A.weekTotal === B.weekTotal ? '兩份一樣。' : esc((A.weekTotal < B.weekTotal ? p.A : p.B).name) + '每週少花 ' + h1(Math.abs(A.weekTotal - B.weekTotal)) + ' 小時。') + '</p>';
        } else {
          var hiN = esc(p[c.hiKey].name), loN = esc(p[c.loKey].name);
          var hiS = c[c.hiKey], loS = c[c.loKey];
          if (c.noExtraTime) {
            html = '<p class="font-semibold text-gray-900 mb-2">' + hiN + '收入高 ' + ntd(c.dMoney) + ' 元，花的時間也沒有比較多</p><p>這種情況沒有「多出來的時間」要算，' + hiN + '的真實時薪就是比較高（' + hr(hiS.real) + ' 對 ' + hr(loS.real) + '）。</p>';
          } else {
            var wN = c.winner === 'A' ? nA : nB, oN = c.winner === 'A' ? nB : nA;
            var wS = c.winner === 'A' ? A : B, oS = c.winner === 'A' ? B : A;
            if (c.winner === 'tie') html += '<p class="font-semibold text-gray-900 mb-2">兩份的真實時薪幾乎打平（稅前）：' + nA + ' ' + hr(A.real) + '，' + nB + ' ' + hr(B.real) + '</p>';
            else html += '<p class="font-semibold text-gray-900 mb-2">' + wN + '的真實時薪比較高（稅前）：' + hr(wS.real) + ' 對 ' + hr(oS.real) + '</p>';
            if (c.winnerAfterTax && c.winnerAfterTax !== c.winner) {
              html += '<p class="mb-2" style="color:#C5611A">注意：' + (c.winnerAfterTax === 'tie' ? '算到稅後，兩份幾乎打平（' : '稅後是' + (c.winnerAfterTax === 'A' ? nA : nB) + '比較高（') + nA + ' ' + hr(A.realAfterTax) + '，' + nB + ' ' + hr(B.realAfterTax) + '）。收入高的那份稅率比較高，多賺的錢要先扣稅。</p>';
            }
            // 划算判斷：用稅後邊際 vs 另一份稅後真實時薪；稅後算不出（邊際稅率模式）時用稅前
            var cmpPost = loS.realAfterTax !== null;
            var margCmp = cmpPost ? c.marginalAfterTax : c.marginal, loCmp = cmpPost ? loS.realAfterTax : loS.real;
            html += '<p class="mb-2">' + hiN + '一年多 ' + ntd(c.dMoney) + ' 元，要多花 ' + ntd(c.dHoursYear) + ' 小時（每週多 ' + h1(c.dHoursWeek) + ' 小時）。多出來的這些時間，每小時 <strong>' + hr(c.marginal) + '</strong>' +
              (c.taxMode === 'rate' ? '，用邊際稅率 ' + c.rate + '% 算稅後約 ' : '，稅後約 ') + '<strong>' + hr(c.marginalAfterTax) + '</strong>。';
            if (loCmp !== null && loCmp > 0) {
              var tag = cmpPost ? '（都用稅後比）' : '（邊際稅率模式算不出' + loN + '的稅後時薪，這裡用稅前比）';
              if (Math.round(margCmp) === Math.round(loCmp)) html += '你在' + loN + '每小時是 ' + hr(loCmp) + '，兩邊幾乎一樣' + tag + '。';
              else if (margCmp < loCmp) html += '你在' + loN + '每小時是 ' + hr(loCmp) + '，多出來的時間每小時低了大約 ' + Math.round((1 - margCmp / loCmp) * 100) + '%' + tag + '。';
              else html += '你在' + loN + '每小時是 ' + hr(loCmp) + '，多出來的時間每小時反而更高' + tag + '，以時薪來看多做是划算的。';
            }
            html += '</p>';
            if (c.threshold !== undefined) {
              html += '<p class="mb-2">門檻（稅前）：多賺的 ' + ntd(c.dMoney) + ' 元，換算成' + loN + '的真實時薪，大約是<strong>每週 ' + h1(c.threshold) + ' 小時</strong>。' + hiN + '每週多花的時間超過這個數，它的真實時薪就輸；你現在填的是每週多 ' + h1(c.dHoursWeek) + ' 小時。</p>';
              var wan = Math.round(c.breakeven / 10000);
              if (c.breakevenType === 'match') html += '<p class="mb-2">' + hiN + '的年收入要到大約 <strong>' + wan.toLocaleString('en-US') + ' 萬</strong>，真實時薪才追得上' + loN + '（稅前、時數不變）。</p>';
              else html += '<p class="mb-2">' + hiN + '的年收入要降到大約 <strong>' + wan.toLocaleString('en-US') + ' 萬</strong>以下，真實時薪才會輸給' + loN + '（稅前、時數不變）。</p>';
            }
            html += '<p class="text-xs text-gray-500">時薪只是一把尺。存第一桶金、這段經歷能讓下一份薪水明顯變高、這幾年你本來也沒有更想做的事，這三種情況，收入高那份還是可能值得接；接之前先決定要做幾年。</p>';
          }
        }
        $('conclusion').innerHTML = html;

        // Layers
        function lrow(name, a, b) {
          return '<tr class="border-b border-gray-100"><td class="py-2 pr-2 sm:pr-4">' + name + '</td><td class="py-2 px-2 sm:px-4 text-right">' + hr(a) + '</td><td class="py-2 pl-2 sm:pl-4 text-right">' + hr(b) + '</td></tr>';
        }
        var anyCost = A.cost > 0 || B.cost > 0;
        $('layerBody').innerHTML =
          lrow('帳面（每週 40 小時）', A.paper, B.paper) +
          lrow('換成真實工時', A.l1, B.l1) +
          lrow('再加待命', A.l2, B.l2) +
          lrow('再加通勤', A.l3, B.l3) +
          (anyCost ? lrow('再扣車錢與其他花費', A.real, B.real) : '') +
          (after ? lrow('稅後', A.realAfterTax, B.realAfterTax) : '');

        // Detail
        function drow(name, a, b) {
          return '<tr class="border-b border-gray-100"><td class="py-2 pr-2 sm:pr-4">' + name + '</td><td class="py-2 px-2 sm:px-4 text-right">' + a + '</td><td class="py-2 pl-2 sm:pl-4 text-right">' + b + '</td></tr>';
        }
        var d = drow('每週工時', h1(p.A.work), h1(p.B.work)) +
          drow('每週待命（處理＋折算）', h1(p.A.oncall + A.idleCounted), h1(p.B.oncall + B.idleCounted)) +
          drow('每週通勤（來回）', h1(A.commuteWeek), h1(B.commuteWeek)) +
          drow('每週合計', h1(A.weekTotal), h1(B.weekTotal)) +
          drow('一年合計（× ' + p.weeks + ' 週）', ntd(A.yearHours), ntd(B.yearHours)) +
          drow('一年車錢＋其他花費', ntd(A.cost), ntd(B.cost));
        if (c.taxMode === 'single') d += drow('綜合所得淨額（115 年度單身）', ntd(A.taxInfo.net), ntd(B.taxInfo.net)) + drow('適用稅率', Math.round(A.taxInfo.rate * 100) + '%', Math.round(B.taxInfo.rate * 100) + '%');
        if (after) d += drow('綜所稅', ntd(A.tax), ntd(B.tax));
        $('detailBody').innerHTML = d;
      }

      var SCN = {
        video: { A: {}, B: {} },
        near: { A: { oncall: 0, commute: 20 }, B: {} },
        a53: { A: { work: 52 }, B: {} },
        b50: { A: {}, B: { work: 50 } },
      };
      function setDefaults() {
        ['A', 'B'].forEach(function (j) {
          $(j + '_name').value = DEFAULTS[j].name;
          JOB_FIELDS.forEach(function (k) { $(j + '_' + k).value = fmtField(k, DEFAULTS[j][k]); });
        });
        $('weeks').value = String(DEFAULTS.weeks); $('taxMode').value = DEFAULTS.taxMode; $('rate').value = String(DEFAULTS.rate);
      }
      $('presetBtn').addEventListener('click', function () { setDefaults(); render(true, false); });
      document.querySelectorAll('.scnBtn').forEach(function (b) {
        b.addEventListener('click', function () {
          setDefaults();
          var s = SCN[b.getAttribute('data-scn')];
          ['A', 'B'].forEach(function (j) { Object.keys(s[j]).forEach(function (k) { $(j + '_' + k).value = fmtField(k, s[j][k]); }); });
          render(true, false);
        });
      });
      var ids = ['weeks'];
      ['A', 'B'].forEach(function (j) { ids.push(j + '_name'); JOB_FIELDS.forEach(function (k) { ids.push(j + '_' + k); }); });
      ids.forEach(function (id) {
        $(id).addEventListener('input', function () { render(false); });
        $(id).addEventListener('change', function () { render(true); });
      });
      ['taxMode', 'rate'].forEach(function (id) { $(id).addEventListener('change', function () { render(true); }); });
      render(false);
    })();
  </script>
</BaseLayout>
