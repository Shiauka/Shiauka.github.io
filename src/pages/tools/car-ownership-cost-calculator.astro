        $('resNote').textContent = p.resPct === null
          ? `殘值用概略折舊曲線：第 1 年剩 85%、5 年剩 45%、10 年剩 15%、15 年剩約 10%。這是概略行情、品牌差異大；持有 ${N} 年估剩 ${pct1(r.resPctEnd)}。`
          : `殘值用你填的 ${pct1(r.resPctEnd)}；逐年車值沿用概略曲線的形狀等比例縮放。`;

        if (r.price <= 0) {
          $('cards').innerHTML = '';
          $('conclusion').innerHTML = '<p>請輸入車價。</p>';
          ['insight', 'compare', 'rule', 'catBody', 'yearBody'].forEach(id => { $(id).innerHTML = ''; });
