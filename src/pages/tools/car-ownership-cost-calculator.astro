        }

        // Cards
        $('cards').innerHTML = `
          <div class="rounded-2xl border border-gray-200 p-5">
            <div class="text-sm font-medium text-gray-600 mb-1">帳面成本（${N} 年）</div>
            <div class="text-2xl font-bold text-gray-900">${wan(r.book)}</div>
            <div class="text-xs text-gray-500 mt-1">每月 ${ntd(r.bookMonthly)}；折舊＋油錢＋保險＋保養＋停車＋稅＋其他${r.loanInterest > 0 ? '＋利息' : ''}</div>
          </div>
