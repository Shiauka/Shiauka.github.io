            <div class="text-sm font-medium text-gray-600 mb-1">每公里成本（帳面）</div>
            <div class="text-2xl font-bold text-gray-900">${r.perKm === null ? '—' : 'NT$' + (Math.round(r.perKm * 10) / 10).toFixed(1)}</div>
