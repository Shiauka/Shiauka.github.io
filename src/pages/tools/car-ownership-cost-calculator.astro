        const incomeLine = rl.income > 0
          ? `<li>車相關每月總支出 ≤ 稅前月收入 10%（${ntd(rl.income * 0.1)}）：真實月成本 ${ntd(r.bookMonthly)}，佔 <strong>${pct1(rl.bookPctIncome)}</strong>${rl.loanPctIncome !== null ? `；車貸期間每月實際扣款（月付＋開銷）約 ${ntd(r.loanPeriodMonthly)}，佔 ${pct1(rl.loanPctIncome)}` : ''} → ${mark(rl.incomeOk)}</li>`
          : '<li>車相關每月總支出 ≤ 稅前月收入 10%：填入稅前月收入就能看</li>';
        $('rule').innerHTML = `
          <p class="font-semibold text-gray-900 mb-2">🧮 20/4/10 檢查（美國理財圈的經驗法則，方向可參考、不用照抄）</p>
          <p class="text-xs text-gray-500 mb-2">10% 這一條原意是每月實際付出去的現金；有車貸時看貸款期間每月扣款（月付＋開銷）。這裡另外用帳面月成本（含折舊、不含機會成本）一起比、取較高者，是比原法則更嚴格的延伸看法。</p>
          <ul class="list-disc pl-5 space-y-1 mb-2">
            <li>頭期款 ≥ 兩成：${r.isLoan ? `你付 ${pct1(rl.downPct)}` : '現金一次付清'} → ${mark(rl.downOk)}</li>
            <li>車貸 ≤ 4 年：${r.isLoan && r.principal > 0 ? `你貸 ${r.loanYears} 年，月付 ${ntd(r.pmt)}` : '沒有車貸'} → ${mark(rl.loanOk)}</li>
            ${incomeLine}
          </ul>
          <p class="text-gray-600">要算的是全部，不是月付：同一台車，月收入 6 萬跟 15 萬的人，代表的意思完全不一樣。把含機會成本的每月 ${ntd(r.allInMonthly)}，跟你每個月要存下來的錢放在一起看，看它們搶不搶得過。</p>`;

        // Category table
        const c = r.cats;
        const catRows = [
          ['折舊（車價 − 殘值）', c.depreciation],
          [r.isEV ? '電費' : '油錢', c.fuel],
          ['保險', c.insurance],
          ['保養維修', c.maint],
          ['停車', c.parking],
          ['牌照稅＋公路養管費', c.tax],
          ['其他（洗車、過路費等）', c.other],
        ];
        if (r.isLoan) catRows.push(['車貸利息（持有期間）', c.interest]);
        const tr = (label, v, share, strong, color) => `<tr class="border-b border-gray-100">
            <td class="py-2 pr-3 ${strong ? 'font-semibold text-gray-900' : ''}">${label}</td>
            <td class="py-2 px-3 text-right ${strong ? 'font-semibold' : ''}" ${color ? 'style="color:#C5611A"' : ''}>${ntd(v)}</td>
            <td class="py-2 px-3 text-right text-gray-500">${ntd(v / r.months)}</td>
            <td class="py-2 pl-3 text-right text-gray-500">${share}</td></tr>`;
        const sh = (v) => r.book > 0 ? pct1(v / r.book * 100) : '—';
        $('catBody').innerHTML = catRows.map(([l, v]) => tr(l, v, sh(v))).join('')
          + tr('帳面成本合計', r.book, '100%', true)
          + tr(`機會成本：${r.isLoan ? '頭期款' : '車價'}的未實現成長`, r.lumpGrowth, '')
          + tr('機會成本：每月支出的未實現成長', r.flowGrowth, '')
          + tr('含機會成本合計', r.allIn, '', true, true);

        // Year table
        $('yearBody').innerHTML = r.rows.map(y => `<tr class="border-b border-gray-100">
            <td class="py-2 pr-3">${y.year}</td>
            <td class="py-2 px-3 text-right text-gray-500">${ntd(y.value)}</td>
            <td class="py-2 px-3 text-right">${ntd(y.dep)}</td>
            <td class="py-2 px-3 text-right">${ntd(y.fuel)}</td>
            <td class="py-2 px-3 text-right">${ntd(y.insurance)}</td>
            <td class="py-2 px-3 text-right">${ntd(y.maint)}</td>
            <td class="py-2 px-3 text-right">${ntd(y.parking)}</td>
            <td class="py-2 px-3 text-right">${ntd(y.tax)}</td>
            <td class="py-2 px-3 text-right">${ntd(y.other)}</td>
            <td class="py-2 px-3 text-right">${ntd(y.interest)}</td>
            <td class="py-2 pl-3 text-right font-medium text-gray-900">${ntd(y.total)}</td></tr>`).join('');
      }

      function applyValues(vals) {
        Object.keys(vals).forEach(id => { if ($(id)) $(id).value = vals[id]; });
      }

      $('presetBtn').addEventListener('click', () => {
        applyValues(DEF);
        presetActive = true;
        render(true);
      });
      $('presetNote').textContent = PRESET_NOTE;

      Object.keys(LIM).forEach(id => {
        $(id).addEventListener('input', () => { if (['ins1', 'ins4', 'other', 'parking'].indexOf(id) >= 0) presetActive = $('other').value.replace(/,/g, '') === '19312'; render(false); });
        $(id).addEventListener('change', () => render(true));
      });
      ['payMode', 'cc', 'resMode'].forEach(id => $(id).addEventListener('change', () => render(true)));
      render(false);
    })();
  </script>
</BaseLayout>
