---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title="買車 10 年真實成本計算機"
  description="一台 100 萬的車，開 10 年帳面約 181 萬；加上那 100 萬本來會長出來的部分約 278 萬，連每月開銷的投資成長也算約 319 萬。填入車價、付款方式、排氣量、里程、停車與保險，算出折舊＋油錢＋保險＋稅＋停車的總成本、每月與每公里多少、機會成本，以及跟不買車的交通費比——對應 EP57。"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <!-- Hero -->
    <div class="mb-8">
      <p class="text-brand font-medium text-sm uppercase tracking-wide mb-2">Tools · 對應 EP57</p>
      <h1 class="text-3xl font-bold mb-3">買車 10 年真實成本計算機</h1>
      <p class="text-gray-600 leading-relaxed">
        報價單上最大的數字是車價，但一台車真正的價格，要把<strong>折舊、油錢、保險、停車、稅</strong>全部加起來；
        如果是付現金，還要算上<strong>那筆錢本來會長出來的部分</strong>——它不會出現在任何一張帳單上。
        填入你要買的車和你的生活，算出持有這幾年的總成本、換算成每個月多少，再跟不買車時的交通費放在一起比。
      </p>
    </div>

    <!-- Inputs -->
    <div class="rounded-2xl border border-gray-200 p-6 mb-8 bg-gray-50/60">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h2 class="font-semibold text-gray-900">你要買的車</h2>
        <div class="flex flex-wrap gap-2">
          <button id="presetBtn" type="button" class="text-sm font-medium px-3 py-1.5 rounded-lg border border-gray-300 text-gray-700 hover:border-brand transition-colors">回到交通部平均（影片的數字）</button>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <label class="block">
          <span class="text-sm text-gray-600">車價（元，可打「100萬」）</span>
          <input id="price" type="text" inputmode="decimal" value="1,000,000"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">付款方式</span>
          <select id="payMode"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 bg-white focus:border-brand focus:ring-1 focus:ring-brand outline-none">
            <option value="cash" selected>現金一次付清</option>
            <option value="loan">頭期款＋車貸</option>
          </select>
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">持有年數（1–15）</span>
          <input id="years" type="number" min="1" max="15" step="1" value="10"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block loanOnly hidden">
          <span class="text-sm text-gray-600">頭期款（元）</span>
          <input id="down" type="text" inputmode="decimal" value="200,000"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block loanOnly hidden">
          <span class="text-sm text-gray-600">貸款年限（年，1–7）</span>
          <input id="loanYears" type="number" min="1" max="7" step="1" value="5"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block loanOnly hidden">
          <span class="text-sm text-gray-600">車貸年利率（%，0 也可以）</span>
          <input id="loanRate" type="number" min="0" max="20" step="0.1" value="3"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">殘值（賣掉時還值多少）</span>
          <select id="resMode"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 bg-white focus:border-brand focus:ring-1 focus:ring-brand outline-none">
            <option value="auto" selected>依概略折舊曲線自動估</option>
            <option value="manual">自己填殘值 %</option>
          </select>
        </label>
        <label class="block resManual hidden">
          <span class="text-sm text-gray-600">賣掉時剩原價的 %（0–100）</span>
          <input id="resPct" type="number" min="0" max="100" step="1" value="15"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">排氣量（牌照稅＋公路養管費，2026/10）</span>
          <select id="cc"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 bg-white focus:border-brand focus:ring-1 focus:ring-brand outline-none">
            <option value="c1200">601–1,200cc 汽油</option>
            <option value="c1800" selected>1,201–1,800cc 汽油</option>
            <option value="c2400">1,801–2,400cc 汽油</option>
            <option value="c3000">2,401–3,000cc 汽油</option>
            <option value="c3600">3,001–3,600cc 汽油</option>
            <option value="c4200">3,601–4,200cc 汽油</option>
            <option value="ev">純電動車</option>
          </select>
        </label>
        <label class="block evOnly hidden">
          <span class="text-sm text-gray-600">電動車牌照稅（元／年，預設 0）</span>
          <input id="evTax" type="text" inputmode="decimal" value="0"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">一年開幾公里</span>
          <input id="km" type="text" inputmode="decimal" value="12,000"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block gasOnly">
          <span class="text-sm text-gray-600">油耗（公里／公升）</span>
          <input id="kmpl" type="number" min="1" max="100" step="0.1" value="11.4"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block gasOnly">
          <span class="text-sm text-gray-600">油價（元／公升；95 無鉛 2026/10）</span>
          <input id="fuelPrice" type="number" min="0" max="200" step="0.1" value="32.7"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block evOnly hidden">
          <span class="text-sm text-gray-600">每公里電費（元，自填估計）</span>
          <input id="evPerKm" type="number" min="0" max="20" step="0.1" value="0.8"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">每月停車費（元；台北月租平均約 2,979，2026/4 報導）</span>
          <input id="parking" type="text" inputmode="decimal" value="0"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">保險：前 3 年每年（元）</span>
          <input id="ins1" type="text" inputmode="decimal" value="15,000"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">保險：第 4 年起每年（元）</span>
          <input id="ins4" type="text" inputmode="decimal" value="15,000"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">保養維修每年（元；交通部平均 15,584）</span>
          <input id="maint" type="text" inputmode="decimal" value="15,584"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">其他每年（洗車、過路費等）</span>
          <input id="other" type="text" inputmode="decimal" value="19,312"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">投資年化報酬（%，期望值非保證）</span>
          <input id="ret" type="number" min="0" max="15" step="0.5" value="7"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">不買車時的交通費（元／月）</span>
          <input id="alt" type="text" inputmode="decimal" value="2,400"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">計程車每公里（元；台北約 25，2026/10）</span>
          <input id="taxi" type="number" min="1" max="200" step="1" value="25"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
        <label class="block">
          <span class="text-sm text-gray-600">稅前月收入（選填，看 20/4/10）</span>
          <input id="income" type="text" inputmode="decimal" value="" placeholder="例如 60,000"
            class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
        </label>
      </div>
      <p id="notice" class="text-xs text-amber-700 mt-3 hidden"></p>
      <p id="presetNote" class="text-xs text-brand mt-3"></p>
      <p class="text-xs text-gray-400 mt-3" id="ccNote"></p>
      <p class="text-xs text-gray-400 mt-2" id="resNote"></p>
    </div>

    <!-- Verdict cards -->
    <div id="cards" class="grid sm:grid-cols-3 gap-4 mb-6"></div>

    <!-- Conclusion -->
    <div id="conclusion" class="rounded-2xl border border-brand bg-brand/5 p-5 mb-6 text-sm leading-relaxed"></div>

    <!-- Insight -->
    <div id="insight" class="rounded-2xl border border-brand/30 bg-brand/5 p-5 mb-8 text-sm leading-relaxed"></div>

    <!-- Compare -->
    <div id="compare" class="rounded-2xl border border-gray-200 p-6 mb-8 text-sm leading-relaxed"></div>

    <!-- 20/4/10 -->
    <div id="rule" class="rounded-2xl border border-gray-200 p-6 mb-8 text-sm leading-relaxed"></div>

    <!-- Category breakdown -->
    <details class="mb-6" open>
      <summary class="cursor-pointer text-sm font-medium text-brand select-none mb-3">▸ 分項明細（持有期間合計）</summary>
      <div class="overflow-x-auto mt-3">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="text-left text-gray-500 border-b border-gray-200">
              <th class="py-2 pr-3 font-medium">項目</th>
              <th class="py-2 px-3 font-medium text-right">合計</th>
              <th class="py-2 px-3 font-medium text-right">每月</th>
              <th class="py-2 pl-3 font-medium text-right">佔帳面</th>
            </tr>
          </thead>
          <tbody id="catBody"></tbody>
        </table>
      </div>
    </details>

    <!-- Year breakdown -->
    <details class="mb-8">
      <summary class="cursor-pointer text-sm font-medium text-brand select-none mb-3">▸ 逐年明細</summary>
      <div class="overflow-x-auto mt-3">
        <table class="w-full text-sm border-collapse whitespace-nowrap">
          <thead>
            <tr class="text-left text-gray-500 border-b border-gray-200">
              <th class="py-2 pr-3 font-medium">第幾年</th>
              <th class="py-2 px-3 font-medium text-right">年底車值</th>
              <th class="py-2 px-3 font-medium text-right">折舊</th>
              <th class="py-2 px-3 font-medium text-right">油／電</th>
              <th class="py-2 px-3 font-medium text-right">保險</th>
              <th class="py-2 px-3 font-medium text-right">保養</th>
              <th class="py-2 px-3 font-medium text-right">停車</th>
              <th class="py-2 px-3 font-medium text-right">稅費</th>
              <th class="py-2 px-3 font-medium text-right">其他</th>
              <th class="py-2 px-3 font-medium text-right">車貸利息</th>
              <th class="py-2 pl-3 font-medium text-right">當年合計</th>
            </tr>
          </thead>
          <tbody id="yearBody"></tbody>
        </table>
      </div>
    </details>

    <!-- Note -->
    <div class="rounded-2xl border border-gray-200 p-6 mb-8 text-sm text-gray-600 leading-relaxed space-y-2">
      <p class="font-semibold text-gray-900">💡 說明</p>
      <p><strong>這不是勸你不要買車。</strong>會讓買車划算的，通常是這幾種情況：每天通勤的路線沒有好的大眾運輸（像不少在工業區、科學園區上班的人）；家裡有小孩、長輩，常常要一次載好幾個人；或工作本身就要一直跑客戶。這些情況，車是工具不是奢侈品——要做的不是不買，是買的時候把整張帳單看完。</p>
      <p><strong>折舊前面掉最兇：</strong>概略行情是第一年少一成五、五年剩四到五成、十年剩一到一成五，品牌與車款差異很大。習慣五年換一次車的人，十年會付兩次曲線最陡的那一段；把持有年數改成 5 就看得到。</p>
      <p><strong>機會成本是期望值：</strong>那筆錢如果拿去長期投資，用年化 7% 算是預期值，不是保證，市場有好年也有壞年。如果你一兩年內就要買車，頭期款放定存就好，不要放股市；這裡算的機會成本，講的是長期不會用到的錢。</p>
      <p><strong>車貸：</strong>零利率常是拿原本能拿到的現金折扣換的，先問現金價再比；也要問手續費、是否綁原廠保險。一般車貸利率約 2.5–8%（2026/10），利率超過約 4–5% 就跟其他高利負債一樣，先還掉比較實在——確定要付的利息，不能直接拿來跟不確定的報酬比大小。</p>
      <p><strong>電動車：</strong>使用牌照稅法已修正、授權各縣市可對電動車免徵牌照稅到 2030/12/31，實際有沒有免看你設籍的縣市（不免的話，請把「電動車牌照稅」改成你縣市的金額）；公路養管費目前免繳。電動車的折舊、保險、充電便利性都要另外細算。</p>
    </div>

    <!-- Disclaimer + CTA -->
    <p class="text-xs text-gray-400 leading-relaxed mb-6">
      本計算機僅供一般資訊參考，以今天的物價估算、未計入油價與停車費上漲（所以結果偏低）。殘值曲線是中古車概略行情、非官方數據，品牌差異大。牌照稅與公路養管費依自用小客車汽油車費額表；保險、保養、停車等以你填的數字為準。機會成本：一次付出的錢（現金車價或頭期款）以年複利 (1＋r)^N 計；每月開銷、車貸月付與替代交通費視為每月月底投入，月利率取 (1＋r)^(1/12)−1，與一次投入用同一個年化報酬。報酬率是假設值、無法保證。不構成投資、稅務或法律建議。
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="/articles/ep57-car-ownership-true-cost" class="inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-lg bg-brand text-white hover:bg-brand-dark transition-colors">讀 EP57 買車真實成本 →</a>
      <a href="/articles/ep43-lifestyle-inflation" class="inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:border-brand transition-colors">生活費怎麼被墊高（EP43）</a>
      <a href="/tools" class="inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:border-brand transition-colors">看其他工具</a>
    </div>

  </div>

  <script is:inline>
    // ===== 純函式 BEGIN（不碰 DOM；獨立驗證可整段抽出來跑）=====
    // 牌照稅（使用牌照稅法 自用小客車）＋公路養管費（原汽車燃料使用費，汽油自用小客車），元／年
    const CAR_TAX_TABLE = {
      c1200: { label: '601–1,200cc', license: 4320, road: 4320 },
      c1800: { label: '1,201–1,800cc', license: 7120, road: 4800 },
      c2400: { label: '1,801–2,400cc', license: 11230, road: 6180 },
      c3000: { label: '2,401–3,000cc', license: 15210, road: 7200 },
      c3600: { label: '3,001–3,600cc', license: 28220, road: 8640 },
      c4200: { label: '3,601–4,200cc', license: 28220, road: 9810 },
      ev: { label: '純電動車', license: 0, road: 0 },
    };
    const MAX_YEARS = 15;

    function clampN(v, lo, hi) { v = Number(v); if (!isFinite(v)) v = lo; return Math.min(hi, Math.max(lo, v)); }

    // 概略殘值曲線（佔原價 %）：0 年 100、1 年 85、5 年 45、10 年 15、15 年 10，中間線性內插
    const RES_CURVE = [[0, 100], [1, 85], [5, 45], [10, 15], [15, 10]];
    function residualPctAuto(y) {
      y = clampN(y, 0, MAX_YEARS);
      for (let i = 1; i < RES_CURVE.length; i++) {
        const [x0, v0] = RES_CURVE[i - 1], [x1, v1] = RES_CURVE[i];
        if (y <= x1) return v0 + (v1 - v0) * (y - x0) / (x1 - x0);
      }
      return RES_CURVE[RES_CURVE.length - 1][1];
    }
    // 第 y 年底殘值 %；若有自填最終殘值，沿用曲線形狀等比例縮放折舊
    function residualPctAt(y, N, overridePct) {
      const auto = residualPctAuto(y);
      if (overridePct === null || overridePct === undefined || !isFinite(overridePct)) return auto;
      const o = clampN(overridePct, 0, 100);
      const depN = 100 - residualPctAuto(N);
      if (depN <= 0) return o;
      return 100 - (100 - auto) / depN * (100 - o);
    }

    // 本息平均攤還月付
    function annuityPmt(P, ratePct, n) {
      if (!(P > 0) || !(n > 0)) return 0;
      const r = ratePct / 100 / 12;
      if (r === 0) return P / n;
      return P * r / (1 - Math.pow(1 + r, -n));
    }

    // 一筆錢 N 年後（年複利）
    function fvLump(P, retPct, years) { return P * Math.pow(1 + retPct / 100, years); }

    // 每月月底投入的現金流，到最後一個月底的終值。月利率＝(1＋年化)^(1/12)−1（與一次投入同一個年化有效報酬）
    function fvMonthly(flows, retPct) {
      const r = Math.pow(1 + retPct / 100, 1 / 12) - 1;
      let fv = 0;
      for (let i = 0; i < flows.length; i++) fv = fv * (1 + r) + flows[i];
      return fv;
    }

    // 主計算。p 的欄位見 DOM 區 readInputs；所有金額單位：元
    function computeCarCost(p) {
      const N = Math.round(clampN(p.years, 1, MAX_YEARS));
      const months = N * 12;
      const price = clampN(p.price, 0, 1e9);
      const isLoan = p.payMode === 'loan';
      const down = isLoan ? clampN(p.down, 0, price) : price;
      const loanYears = Math.round(clampN(p.loanYears, 1, 7));
      const loanRate = clampN(p.loanRate, 0, 20);
      const tax = CAR_TAX_TABLE[p.cc] || CAR_TAX_TABLE.c1800;
      const isEV = p.cc === 'ev';
      const licenseTax = isEV ? clampN(p.evTax, 0, 1e6) : tax.license;
      const roadFee = isEV ? 0 : tax.road;
      const km = clampN(p.km, 0, 1e6);
      const fuelPerKm = isEV ? clampN(p.evPerKm, 0, 100) : clampN(p.fuelPrice, 0, 1000) / clampN(p.kmpl, 1, 100);
      const fuelYear = km * fuelPerKm;
      const parkingYear = clampN(p.parking, 0, 1e7) * 12;
      const ins1 = clampN(p.ins1, 0, 1e8), ins4 = clampN(p.ins4, 0, 1e8);
      const maint = clampN(p.maint, 0, 1e8), other = clampN(p.other, 0, 1e8);
      const ret = clampN(p.ret, 0, 30);
      const override = (p.resPct === null || p.resPct === undefined || p.resPct === '') ? null : clampN(p.resPct, 0, 100);

      // 車貸
      const principal = isLoan ? Math.max(0, price - down) : 0;
      const loanMonths = principal > 0 ? loanYears * 12 : 0;
      const pmt = annuityPmt(principal, loanRate, loanMonths);
      const interestByYear = new Array(N).fill(0);
      let bal = principal, paidMonths = Math.min(loanMonths, months), totalPmt = 0;
      for (let m = 0; m < paidMonths; m++) {
        const it = bal * loanRate / 100 / 12;
        interestByYear[Math.floor(m / 12)] += it;
        bal = Math.max(0, bal - (pmt - it));
        totalPmt += pmt;
      }
      const payoff = bal;                          // 持有期滿、賣車時一次還清的貸款餘額
      const loanInterest = interestByYear.reduce((a, b) => a + b, 0);

      // 殘值與逐年
      const resPctEnd = residualPctAt(N, N, override);
      const residual = Math.min(price, price * resPctEnd / 100);
      const depreciation = price - residual;
      const rows = [];
      const cats = { depreciation, fuel: 0, insurance: 0, maint: 0, parking: 0, tax: 0, other: 0, interest: loanInterest };
      let prevVal = price;
      for (let y = 1; y <= N; y++) {
        const val = Math.min(price, price * residualPctAt(y, N, override) / 100);
        const ins = y <= 3 ? ins1 : ins4;
        const row = {
          year: y, value: val, dep: prevVal - val, fuel: fuelYear, insurance: ins, maint, parking: parkingYear,
          tax: licenseTax + roadFee, other, interest: interestByYear[y - 1],
        };
        row.running = row.fuel + row.insurance + row.maint + row.parking + row.tax + row.other;
        row.total = row.dep + row.running + row.interest;
        rows.push(row);
        prevVal = val;
        cats.fuel += row.fuel; cats.insurance += ins; cats.maint += maint; cats.parking += parkingYear;
        cats.tax += row.tax; cats.other += other;
      }
      const running = cats.fuel + cats.insurance + cats.maint + cats.parking + cats.tax + cats.other;
      const book = depreciation + running + loanInterest;

      // 機會成本：統一用年化有效報酬 r。一次付出（現金車價或頭期款）×(1+r)^N；每月開銷＋車貸月付 月底投入、月利率 (1+r)^(1/12)−1
      const upfront = down;
      const lumpFV = fvLump(upfront, ret, N);
      const lumpGrowth = lumpFV - upfront;
      const flows = [];
      for (let m = 0; m < months; m++) flows.push(rows[Math.floor(m / 12)].running / 12 + (m < paidMonths ? pmt : 0));
      const flowSum = flows.reduce((a, b) => a + b, 0);
      const flowFV = fvMonthly(flows, ret);
      const flowGrowth = flowFV - flowSum;
      const oppTotal = lumpGrowth + flowGrowth;
      const allIn = book + oppTotal;

      // 不買車
      const altMonthly = clampN(p.alt, 0, 1e7);
      const altSum = altMonthly * months;
      const altFV = fvMonthly(new Array(months).fill(altMonthly), ret);
      const altGrowth = altFV - altSum;

      // 損益兩平（vs 計程車）：固定成本 / (計程車每公里 − 油電每公里)
      const taxi = clampN(p.taxi, 1, 1000);
      const fixedAnnual = (depreciation + loanInterest) / N + (cats.insurance + cats.maint + cats.parking + cats.tax + cats.other) / N;
      const breakEvenKm = taxi > fuelPerKm ? fixedAnnual / (taxi - fuelPerKm) : null;

      // 20/4/10
      const income = clampN(p.income, 0, 1e9);
      const firstYearRunningMonthly = rows[0].running / 12;
      const loanPeriodMonthly = paidMonths > 0 ? pmt + firstYearRunningMonthly : 0;
      const bookMonthly = book / months;
      const rule = {
        downPct: price > 0 ? down / price * 100 : 100,
        downOk: price > 0 ? down / price >= 0.2 : true,
        loanOk: !isLoan || principal <= 0 || loanYears <= 4,
        income,
        bookPctIncome: income > 0 ? bookMonthly / income * 100 : null,
        loanPctIncome: income > 0 && loanPeriodMonthly > 0 ? loanPeriodMonthly / income * 100 : null,
      };
      rule.incomeOk = income > 0 ? Math.max(bookMonthly, loanPeriodMonthly) <= income * 0.1 : null;

      const totalKm = km * N;
      return {
        N, months, price, isLoan, isEV, down, principal, loanYears, loanRate, pmt, loanMonths, paidMonths, payoff, totalPmt, loanInterest,
        licenseTax, roadFee, fuelPerKm, fuelYear, km, totalKm,
        resPctEnd, residual, depreciation, rows, cats, running, book, bookMonthly,
        upfront, lumpFV, lumpGrowth, flowSum, flowFV, flowGrowth, oppTotal, allIn, allInMonthly: allIn / months,
        perKm: totalKm > 0 ? book / totalKm : null,
        altMonthly, altSum, altFV, altGrowth, diffBook: book - altSum, diffAllIn: allIn - altFV,
        taxi, fixedAnnual, breakEvenKm, loanPeriodMonthly, rule,
      };
    }

    // 金額字串解析：吃千分位、空白、NT$、元；含「萬」則 ×10000
    function parseMoney(s) {
      const str = String(s === undefined || s === null ? '' : s);
      const isWan = /萬/.test(str);
      const v = parseFloat(str.replace(/NT\$|\$|,|，|\s|萬|元/gi, ''));
      if (!isFinite(v)) return NaN;
      return isWan ? v * 10000 : v;
    }
    // ===== 純函式 END =====

    if (typeof window !== 'undefined') window.__ep57 = { CAR_TAX_TABLE, residualPctAuto, residualPctAt, annuityPmt, fvLump, fvMonthly, computeCarCost, parseMoney };

    // ===== DOM =====
    (function () {
