        years: [1, 15, '持有年數', true], loanYears: [1, 7, '貸款年限', true], loanRate: [0, 20, '車貸利率'], resPct: [0, 100, '殘值 %'],
        kmpl: [1, 100, '油耗'], fuelPrice: [0, 200, '油價'], evPerKm: [0, 20, '每公里電費'], ret: [0, 15, '投資報酬'], taxi: [1, 200, '計程車每公里'],
      };

      function readField(id, msgs, commit) {
