---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { openTs, isPublished } from '@/lib/publish'

// 依集數由新到舊排列（與文章列表一致：EP 大的在上）
// pubDate = 對應集數的公開日；公開日 19:00（台灣）前不在列表顯示，到時前端自動現身。
const tools = [
  {
    href: '/tools/retirement-floor-gap-calculator',
    title: '退休缺口計算機：扣掉勞保，你自己要存多少',
    desc: '月花 5 萬用 3.5% 提領要存 1,714 萬，但受僱上班族有勞保這塊領到過世的地板。填每月花費、勞保（投保薪資與年資，或直接填月領）、請領年齡、勞退專戶與退休年齡，算出只把勞保當地板、扣掉勞退後自己要存多少；提早退休時，勞保還沒開始領那幾年要另外補的錢也一起算，並附勞保打八折的壓力測試。',
    episode: 61,
    pubDate: '2026-11-13',
    tags: ['勞保', '勞退', '退休規劃'],
  },
  {
    href: '/tools/rebalance-check-calculator',
    title: '再平衡檢查計算機：你的股票占幾成？',
    desc: '要不要停利、要不要加碼，都得先猜漲跌；這支只算今天算得出來的數字。填入股票市值、現金那一邊（不含緊急備用金）、目標比例與每月可存的錢，算出股票比例、是否超過 5 個百分點門檻、調回目標要賣多少、光靠新的錢要補幾個月，並對照 EP04 崩盤劇本看再跌一到三成時的比例。',
    episode: 60,
    pubDate: '2026-11-10',
    tags: ['再平衡', '資產配置', '0050'],
  },
  {
    href: '/tools/labor-insurance-claim-age-calculator',
    title: '勞保請領年齡損益兩平計算機',
    desc: '勞保老年年金提前一年少 4%、延後一年多 4%，比例終身固定。填入平均月投保薪資與年資，算出 60 到 70 歲開始領的月領金額、彼此的損益兩平年齡、活到 75–95 歲的累計總額，可加入實質折現率，並對照 114 年生命表的存活機率。',
    episode: 59,
    pubDate: '2026-11-06',
    tags: ['勞保', '退休規劃', '損益兩平'],
  },
  {
    href: '/tools/late-start-investing-calculator',
    title: '40 歲才開始投資計算機',
    desc: '同樣要在 65 歲存到 1,000 萬（今天的購買力），25 歲開始每月 6,745，40 歲開始每月 17,073，是兩倍半不是來不及。填入年紀、現在的存款、打算幾歲退休與目標，算出每月要投入多少、照目前投入退休時有多少，以及再晚 1 年、5 年開始每月要多付多少。',
    episode: 58,
    pubDate: '2026-11-03',
    tags: ['40歲投資', '退休規劃', '複利'],
  },
  {
    href: '/tools/car-ownership-cost-calculator',
    title: '買車 10 年真實成本計算機',
    desc: '一台 100 萬的車，開 10 年帳面約 181 萬；加上那 100 萬本來會長出來的部分約 278 萬，連每月開銷的投資成長也算約 319 萬。填入車價、付現或貸款、排氣量、里程、停車與保險，算出折舊＋油錢＋保險＋稅＋停車的總成本、每月與每公里多少，並跟不買車時的交通費比。',
    episode: 57,
    pubDate: '2026-10-30',
    tags: ['買車', '養車成本', '機會成本'],
  },
  {
    href: '/tools/xinqingan-grace-period-calculator',
    title: '房貸寬限期月付時間軸',
    desc: '新青安補貼退場＋寬限期到期，你每個月會繳多少？填入貸款金額、年限、寬限期與撥貸年月，排出每一年的月付、跳動哪個月發生、其中多少來自利率，並比較預演月付存下的錢拿去提前還款和留現金各差多少。',
    episode: 55,
    pubDate: '2026-10-23',
    tags: ['新青安', '寬限期', '房貸'],
  },
  {
    href: '/tools/leveraged-etf-drawdown-calculator',
    title: '正 2 腰斬壓力測試',
    desc: '00631L 十一年腰斬三次，最深一次跌 55%。填入你的正 2、台股與其他資產，算出它腰斬那一天你整體少多少、正 2 最多能放幾成，以及今年漲完之後比例偏掉多少。',
    episode: 54,
    pubDate: '2026-10-20',
    tags: ['00631L', '槓桿ETF', '再平衡'],
  },
  {
    href: '/tools/dividend-tax-nhi-calculator',
    title: '股利所得稅 × 二代健保補充保費計算機',
    desc: '一年領 50 萬股利，真正拿到手的是多少？算出合併計稅 vs 分開計稅哪個省、每一筆配息會不會被扣 2.11% 補充保費，以及稅加保費吃掉股利的幾成。',
    episode: 53,
    pubDate: '2026-10-16',
    tags: ['股利所得', '補充保費', '合併計稅'],
  },
  {
    href: '/tools/labor-pension-voluntary-calculator',
    title: '勞退自提真實效益計算機',
    desc: '自提 6% 值不值得，看的是你的稅率級距。填入月薪，算出月提繳工資級距、每年省下的稅，再把「自提進勞退」和「不提、拿稅後的錢自己投資」並排算到請領那天，含退職所得稅。',
    episode: 51,
    pubDate: '2026-10-09',
    tags: ['勞退自提', '節稅', '退職所得'],
  },
  {
    href: '/tools/parents-pension-gap-calculator',
    title: '爸媽退休金缺口計算機',
    desc: '孝親費該給多少，看的是爸媽每月從勞保、國保領多少。填入爸媽的年資與投保薪資，算出每月缺口、要補幾年、兄弟姊妹每人每月該分多少，以及勞保提前或延後請領的損益兩平年齡。',
    episode: 50,
    pubDate: '2026-10-06',
    tags: ['孝親費', '勞保年金', '國民年金'],
  },
  {
    href: '/tools/overseas-income-amt-checker',
    title: '海外所得兩道門檻檢查器',
    desc: '海外所得 100 萬決定要不要算進去，750 萬決定算完要不要繳錢——而且薪水已經先佔掉一塊。填入股息、利息、實現價差與綜合所得淨額，看你卡在哪一道門檻、要補多少。',
    episode: 49,
    pubDate: '2026-10-02',
    tags: ['海外所得', '最低稅負制', '美股'],
  },
  {
    href: '/tools/buy-vs-rent-calculator',
    title: '買房 vs 租房 試算器',
    desc: '買房三十年後是一間房，租房把頭期款和每月差額投進市場是一個組合——哪邊大？填入房價、利率、月租與你的假設，看兩條資產曲線賽跑，以及房價要漲多少買房才反超。',
    episode: 24,
    pubDate: '2026-07-07',
    tags: ['買房租房', '機會成本', '槓桿'],
  },
  {
    href: '/tools/dca-snowball-calculator',
    title: '定期定額複利雪球計算機',
    desc: '輸入月投金額、年數與報酬率，看本金與複利怎麼分、二十年後超過一半的資產是複利長出來的，以及雪球哪一年開始滾贏本金。',
    episode: 23,
    pubDate: '2026-07-03',
    tags: ['定期定額', '複利', '自動化'],
  },
  {
    href: '/tools/currency-exchange-calculator',
    title: '換匯成本比較器',
    desc: '台幣換美元，即期＋電匯、臨櫃現鈔、Wise 哪條最便宜？把金額填進去，看三層成本攤開比一次，還有電匯費被攤薄的轉折。',
    episode: 22,
    pubDate: '2026-06-30',
    tags: ['換匯', '匯率', '海外券商'],
  },
  {
    href: '/tools/brokerage-fee-calculator',
    title: '複委託 vs 海外券商 費用比較計算機',
    desc: '輸入定期定額金額與持有年數，算出複委託 VOO、海外券商 VOO、台灣 00646 三條路的累積成本與轉折點。',
    episode: 18,
    pubDate: '2026-06-16',
    tags: ['費用比較', '複委託', '00646'],
  },
  {
    href: '/tools/retirement-number-calculator',
    title: '財務自由數字計算機',
    desc: '用退休後支出、3.5% 提領率、通膨反推你的財務自由數字，再從現有資產與月投入算出預估達標年齡。',
    episode: 15,
    pubDate: '2026-06-05',
    tags: ['財務自由', '提領率', '退休規劃'],
  },
]

const now = Date.now()
---

<BaseLayout
  title="工具"
  description="祿哥做的免費互動小工具——把每集播客的計算題變成你自己能玩的計算機。"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">

    <div class="mb-10">
      <p class="text-brand font-medium text-sm uppercase tracking-wide mb-2">Tools</p>
      <h1 class="text-3xl font-bold mb-3">工具</h1>
      <p class="text-gray-600 max-w-2xl">
        把每集播客講的計算題，變成你自己能調數字的互動計算機。免費、純前端、不收集任何資料。
      </p>
    </div>

    <div class="space-y-4">
      {tools.map(tool => {
        const live = isPublished(tool.pubDate, now)
        return (
        <a
          href={tool.href}
          data-reveal-ts={live ? undefined : String(openTs(tool.pubDate))}
          class:list={[
            'flex items-start gap-4 p-5 rounded-xl border border-gray-200 hover:border-brand hover:shadow-md transition-all group',
            { hidden: !live },
          ]}
        >
          <div class="shrink-0 mt-0.5">
            <span class="inline-block text-xs font-semibold bg-brand/10 text-brand px-2.5 py-1 rounded-full whitespace-nowrap">
              EP{String(tool.episode).padStart(2, '0')}
            </span>
          </div>
          <div class="flex-1 min-w-0">
            <h2 class="font-semibold text-gray-900 group-hover:text-brand transition-colors leading-snug mb-1">
              {tool.title}
            </h2>
            <p class="text-sm text-gray-500 line-clamp-2">{tool.desc}</p>
            <div class="flex flex-wrap gap-1.5 mt-2">
              {tool.tags.map(tag => (
                <span class="text-xs text-gray-400">#{tag}</span>
              ))}
            </div>
          </div>
          <span class="shrink-0 text-gray-400 group-hover:text-brand transition-colors mt-1">→</span>
        </a>
        )
      })}
    </div>

  </div>
</BaseLayout>

<script>
  import '@/scripts/reveal.ts'
</script>
